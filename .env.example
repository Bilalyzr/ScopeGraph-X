# ScopeGraph X — local development configuration (no real secrets)
# Copy to .env for local development.

# SQLite dev database (zero external ports). Production target: PostgreSQL via DATABASE_URL.
DATABASE_URL="file:./dev.db"

# Local content-addressed object store for encrypted/redacted evidence (dev path)
EVIDENCE_STORE_DIR=".data/evidence"

# Evidence retention in days (NFR-07)
EVIDENCE_RETENTION_DAYS="30"

# Session lifetime in hours
SESSION_TTL_HOURS="24"

# AI provider: "mock" keeps everything local with no API key. A real provider
# requires credentials supplied by the operator; never commit real keys.
AI_PROVIDER="mock"

# Egress mode: "simulated" ALWAYS in development — the policy gateway evaluates
# and logs outbound requests but no real network traffic leaves the process.
EGRESS_MODE="simulated"

# 32-byte key (64 hex chars) for AES-256-GCM at-rest encryption of evidence
# and secrets. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# REQUIRED when NODE_ENV=production (the app refuses to start sealing without it).
EVIDENCE_ENCRYPTION_KEY=""

# ---- v0.3 integrations (all OFF / mock by default) ----

# Passive discovery: "mock" (fixtures, default) or "live" — live queries PUBLIC
# records (DNS, crt.sh CT logs, RDAP) for hosts that are already program assets.
# Never sends requests to the targets themselves.
PASSIVE_DISCOVERY_MODE="mock"

# Real AI provider (opt-in). Any OpenAI-compatible endpoint. Default: mock.
# AI_PROVIDER="openai-compatible"
# AI_BASE_URL="https://api.openai.com/v1"
# AI_API_KEY=""
# AI_MODEL="gpt-4o-mini"

# OIDC SSO (authorization-code flow, RS256/JWKS verified). Off unless all set.
# OIDC_ISSUER="https://your-idp.example.com/realms/main"
# OIDC_CLIENT_ID=""
# OIDC_CLIENT_SECRET=""
# OIDC_REDIRECT_URI=""            # defaults to <origin>/api/auth/oidc/callback
# OIDC_DEFAULT_ORG_ID=""          # org id for JIT-provisioned SSO users (RESEARCHER)

# Ticketing sync for REPORTED findings: none (default) | recorder | jira
TICKETING_PROVIDER="none"
# JIRA_BASE_URL="https://yourcompany.atlassian.net"
# JIRA_EMAIL=""
# JIRA_API_TOKEN=""
# JIRA_PROJECT_KEY="SGX"
# JIRA_ISSUE_TYPE="Bug"

# Key rotation: after generating a NEW EVIDENCE_ENCRYPTION_KEY, set the OLD key
# here and run `npm run rotate-key`; then remove this variable.
# EVIDENCE_ENCRYPTION_KEY_PREVIOUS=""

# Worker identity for multi-node pools (auto-generated when unset)
# SGX_WORKER_ID="worker-a"
