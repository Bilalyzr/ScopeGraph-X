# ScopeGraph X — local development configuration (no real secrets)
# Copy to .env for local development.

# SQLite dev database (zero external ports). Production target: PostgreSQL via DATABASE_URL.
DATABASE_URL="file:./dev.db"

# Local content-addressed object store for encrypted/redacted evidence (dev path)
EVIDENCE_STORE_DIR=".data/evidence"

# Evidence retention in days (NFR-07)
EVIDENCE_RETENTION_DAYS="30"

# Session lifetime in hours
SESSION_TTL_HOURS="24"

# AI provider: "mock" keeps everything local with no API key. A real provider
# requires credentials supplied by the operator; never commit real keys.
AI_PROVIDER="mock"

# Egress mode: "simulated" ALWAYS in development — the policy gateway evaluates
# and logs outbound requests but no real network traffic leaves the process.
EGRESS_MODE="simulated"

# 32-byte key (64 hex chars) for AES-256-GCM at-rest encryption of evidence
# and secrets. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# REQUIRED when NODE_ENV=production (the app refuses to start sealing without it).
EVIDENCE_ENCRYPTION_KEY=""
